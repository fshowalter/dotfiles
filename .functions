# Upload a given path to the 'audio' folder in B2.
function upaudio2b2() {
  for file in $1/**/*.(flac|m4a|ape|accurip|cue|pdf|png|jpg|wv|xcf|log|txt|zip); do \
    b2v3 file upload fcs-archive "$file" "audio/${file#./}";
  done
}

# Upload a given path to the 'video/downloads' folder in B2.
function upvideo2b2() {
  for file in $1/**/*; do \
    b2v3 file upload fcs-archive "$file" "video/downloads/${file#./}";
  done
}

# Convert all flac files in the current director to mp3, deleting the intermidiate wav file.
function flac2mp3() {
  for file in (*).flac; do \
    flac -d "$file"; \
    lame -V0 "${file:r}.wav" "${file:r}.mp3";
    rm "${file:r}.wav"
  done
}

# Open a PR on Github for the current branch and set it to auto-merge.
function pr() {
  gh pr create --fill;
  gh pr merge --squash --auto --delete-branch;
}

# Convert all wav files in the current director to flac.
function wav2flac() {
  for file in (*).wav; do \
    flac --best "$file"; \
    rm "${file:r}.wav"
  done
}

# recusively remove pycache files
function pyclean () {
    find . -type f -name '*.py[co]' -delete -o -type d -name __pycache__ -delete
}

# Use wget to download the given url saved to the given path.
function wgfile() {
  wget -c --retry-connrefused --retry-on-http-error=509 --tries=0 --timeout=5 $2 -O $1
}

# let claude create a nice commit message.
function gcauto() {
  git commit -m "$(claude -p "Look at the staged git changes and create a summarizing git commit title. Only respond with the title and no affirmation.")"
}

# Walk the local branches that no longer exist on the remote and offer to delete
# each one. Enter (or anything other than 'y') keeps the branch.
function prunebranches() {
  git rev-parse --is-inside-work-tree > /dev/null 2>&1 || {
    echo "prunebranches: not a git repository." >&2
    return 1
  }

  if [[ -z "$(git remote)" ]]; then
    echo "prunebranches: this repo has no remote, nothing to compare against." >&2
    return 1
  fi

  echo "Fetching and pruning remote-tracking refs..."
  git fetch --all --prune --quiet || return 1

  local current="$(git symbolic-ref --quiet --short HEAD)"
  local line branch state
  local -a stale

  # Each line is "<branch> <state>", where state is one of:
  #   gone    -> had an upstream, but it was deleted on the remote
  #   local   -> never pushed, no upstream set
  #   tracked -> still present on the remote
  for line in ${(f)"$(git for-each-ref refs/heads --format='%(refname:short) %(if)%(upstream)%(then)%(if:equals=[gone])%(upstream:track)%(then)gone%(else)tracked%(end)%(else)local%(end)')"}; do
    branch="${line%% *}"
    state="${line##* }"
    [[ "$branch" == "$current" || "$state" == "tracked" ]] && continue
    stale+=("$branch [$state]")
  done

  if (( ${#stale} == 0 )); then
    echo "No local branches missing from the remote."
    return 0
  fi

  echo "${#stale} local branch(es) not present on the remote:"
  printf '  %s\n' $stale
  echo

  for line in $stale; do
    branch="${line%% *}"
    if read -q "?Prune ${line}? [y/N] "; then
      echo
      git branch -D "$branch"
    else
      echo
      echo "Keeping ${branch}."
    fi
  done
}

# B2 sync command:
# b2 sync --excludeRegex '(.*\.DS_Store)' --delete --syncThreads 1 --downloadThreads 1 --replaceNewer --compareThreshold 1000 b2://fcs-archive/audio b2/audio